# Copy to .env.local and fill in from Supabase: Project Settings → API Keys
# Both values are public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# NEVER put the service_role / secret key here or in any NEXT_PUBLIC_ variable.
# It bypasses RLS and lives only in the AWS worker and Supabase Edge Functions.
